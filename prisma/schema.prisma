// schema.prisma
// Ver docs/data-model.md para el razonamiento detrás de cada decisión.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  SUPERUSUARIO
  MIEMBRO
}

enum TipoDocumento {
  COTIZACION
  PROPUESTA
  FACTURA
}

enum EstadoDocumento {
  BORRADOR
  ENVIADA
  EN_NEGOCIACION
  ACEPTADA
  RECHAZADA
  VENCIDA
  FACTURADA
}

// INDIVIDUAL: el flujo de siempre (un solo contacto/correo/teléfono en el
// propio Cliente). EMPRESA: clientes corporativos como CMI, donde cada mes
// la cotización se manda a un destinatario distinto bajo el mismo NIT — ahí
// se usan los ContactoCliente en vez del correo suelto del cliente.
// Pedido explícito de Oldemar, reunión 14/08.
enum TipoCliente {
  INDIVIDUAL
  EMPRESA
}

model Empresa {
  id                String   @id @default(cuid())
  nombre            String
  nit               String?
  direccion         String?
  // Persona de contacto de ESTA empresa (la que emite el documento) — se muestra
  // como "Contacto de servicio" en el documento exportado, junto con telefono/email
  // de esta misma empresa. No confundir con Cliente.contacto (el contacto del
  // cliente). Ver docs/document-export.md.
  contacto          String?
  telefono          String?
  email             String?
  // Código de país para armar el link de WhatsApp del botón "Ver / Imprimir"
  // (ej. "502" Guatemala, "507" Panamá, "1" Estados Unidos) — wa.me exige el
  // número completo con código de país, y Cliente.telefono nunca lo incluye.
  // Sirve de default para todos los clientes de esta empresa; un cliente
  // puntual puede sobreescribirlo con su propio Cliente.codigoPais si su
  // WhatsApp real es de un país distinto al de la empresa que lo atiende.
  codigoPais        String   @default("502")
  moneda            String   @default("GTQ")
  correlativoActual Int      @default(1000) // el próximo asignado será +1 (ver lib/correlativo.ts)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  usuarios                  UsuarioEmpresa[]
  clientes                  Cliente[]
  servicios                 Servicio[]
  documentos                Documento[]
  costosOperativos          CostoOperativo[]
  costosOperativosAuditoria CostoOperativoAuditoria[]
  clientesAuditoria         ClienteAuditoria[]
  serviciosAuditoria        ServicioAuditoria[]
  auditoria                 EmpresaAuditoria[]
  activos                   Activo[]
  activosAuditoria          ActivoAuditoria[]
  proyectosAuditoria        ProyectoAuditoria[]

  @@map("empresas")
}

model Usuario {
  id        String     @id @default(cuid())
  clerkId   String     @unique // referencia al usuario en Clerk, fuente de verdad de auth
  nombre    String
  email     String     @unique
  rol       RolUsuario @default(MIEMBRO)
  // Imagen de la firma real (foto/escaneo), guardada como data URI base64
  // ("data:image/png;base64,..."). Nullable: la mayoría de usuarios no la
  // tienen cargada — el documento se sigue imprimiendo con espacio en blanco
  // para firmar a mano, igual que hoy. Sin servicio de archivos nuevo:
  // límite de tamaño validado en el server action (ver actualizarFirmaUsuario).
  firma     String?    @db.Text
  createdAt DateTime   @default(now())

  empresas               UsuarioEmpresa[]
  documentosFirmados     Documento[]               @relation("DocumentoFirmante")
  costosAuditados        CostoOperativoAuditoria[]
  clientesAuditados      ClienteAuditoria[]
  serviciosAuditados     ServicioAuditoria[]
  empresasAuditadas      EmpresaAuditoria[]
  proyectosAuditados     ProyectoAuditoria[]
  activosAuditados       ActivoAuditoria[]
  // Dos relaciones distintas hacia Usuario en UsuarioAuditoria: una fila
  // registra tanto "a quién le cambiaron algo" (usuarioId) como "quién lo
  // hizo" (actorUsuarioId) — Prisma exige nombrar cada lado cuando hay más
  // de una relación entre los mismos dos modelos.
  auditoriasComoAfectado UsuarioAuditoria[]        @relation("UsuarioAuditado")
  auditoriasComoActor    UsuarioAuditoria[]        @relation("UsuarioAuditor")

  @@map("usuarios")
}

// Tabla puente: qué usuario puede acceder a qué empresa.
// El superusuario igual tiene filas aquí para cada empresa (no se asume acceso total
// implícito en el código — se hace explícito en la base de datos también).
model UsuarioEmpresa {
  id        String  @id @default(cuid())
  usuarioId String
  empresaId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, empresaId])
  @@map("usuario_empresa")
}

model Cliente {
  id         String      @id @default(cuid())
  empresaId  String
  empresa    Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo       TipoCliente @default(INDIVIDUAL)
  nombre     String
  nit        String?
  direccion  String?
  contacto   String?
  telefono   String?
  email      String?
  // Solo se llena cuando el WhatsApp real de ESTE cliente es de un país
  // distinto al de la empresa que lo atiende — si es null, se usa
  // Empresa.codigoPais. Ver ese campo para el porqué.
  codigoPais String?
  activo     Boolean     @default(true) // permite ocultar clientes viejos sin borrarlos
  createdAt  DateTime    @default(now())

  documentos         Documento[]
  // Solo se usan cuando tipo = EMPRESA — ver TipoCliente. Un cliente
  // INDIVIDUAL sigue usando el campo `email` de acá arriba, sin tocar nada.
  contactos          ContactoCliente[]
  auditoria          ClienteAuditoria[]
  // Fase 3: un cliente puede tener varios proyectos, y costos asociados
  // directamente a él (sin proyecto específico) — ver modelo Proyecto.
  proyectos          Proyecto[]
  costosOperativos   CostoOperativo[]
  proyectosAuditoria ProyectoAuditoria[]

  @@index([empresaId])
  @@map("clientes")
}

// Fase 3 — nueva entidad para cruzar utilidad (facturado − costos) por
// proyecto de un cliente, no solo por cliente en general. Ver
// docs/fase3-clientes-proyectos-costos-activos.md.
model Proyecto {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  documentos Documento[]
  costos     CostoOperativo[]
  auditoria  ProyectoAuditoria[]

  @@index([clienteId])
  @@map("proyectos")
}

enum AccionCliente {
  CREADO
  EDITADO
}

// Mismo criterio que CostoOperativoAuditoria: bitácora de solo-inserción,
// clienteId opcional con SetNull (Cliente en sí no se borra físicamente,
// solo se desactiva — pero si alguna vez se borrara, esta fila sobrevive).
// `detalle` es un resumen legible de qué campos cambiaron (ver
// lib/auditoria.ts, diffCampos) en vez de duplicar cada campo del modelo acá.
model ClienteAuditoria {
  id            String        @id @default(cuid())
  clienteId     String?
  cliente       Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  empresaId     String
  empresa       Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  accion        AccionCliente
  clienteNombre String
  detalle       String
  usuarioId     String?
  usuario       Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  fecha         DateTime      @default(now())

  @@index([empresaId, fecha])
  @@map("clientes_auditoria")
}

// Destinatarios distintos bajo el mismo NIT corporativo (ej. CMI: 4 personas
// distintas reciben la cotización cada mes, según el servicio). Se elige uno
// al generar/enviar el documento — ver documento-imprimir-toolbar.tsx.
model ContactoCliente {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nombre    String
  email     String
  createdAt DateTime @default(now())

  @@index([clienteId])
  @@map("contactos_cliente")
}

// Categorías fijas pedidas por Oldemar en la reunión del 14/08 (combustible,
// planilla, etc.) — "Otro" cubre lo que no encaje, sin forzar categorías
// nuevas antes de tener más ejemplos reales de gasto.
enum CategoriaCosto {
  COMBUSTIBLE
  PLANILLA
  PROVEEDORES
  PREDIO
  LUZ
  CONSUMIBLES
  // Agregadas por pedido de Oldemar (feedback sobre el módulo ya
  // entregado) — no rompen datos existentes, un enum de Postgres solo
  // admite agregar valores, nunca quitarlos sin migrar filas primero.
  REPUESTOS
  LLANTAS
  OTRO
}

// Gasto operativo real (no una venta) — por eso no puede vivir en Documento,
// que está diseñado para cotizaciones/propuestas/facturas con su propio
// flujo de estados y correlativo. Sirve para calcular "Utilidad neta" en el
// panel: Facturado del mes − Costos del mes. El cálculo automático de
// ISR/IVA queda pendiente de la fórmula exacta que Oldemar va a mandar — no
// se inventa acá.
model CostoOperativo {
  id                   String         @id @default(cuid())
  empresaId            String
  empresa              Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  categoria            CategoriaCosto
  // Solo se usa (y se exige, ver lib/validations/costo.ts) cuando
  // categoria = OTRO — el texto específico que escribe el usuario (ej.
  // "Seguros", "Multas"), para poder filtrar por él después como si fuera
  // una categoría más, sin tener que ampliar el enum fijo cada vez.
  categoriaOtroDetalle String?
  descripcion          String
  monto                Decimal        @db.Decimal(12, 2)
  // Independiente de createdAt: un reporte de julio puede llegar y
  // registrarse recién el 5 de agosto, pero debe contar para julio.
  fechaGasto           DateTime
  // Costos era el único módulo con borrado físico — contradice "nunca se
  // pierde el historial" (CLAUDE.md). Mismo criterio que
  // Cliente.activo/Servicio.activo/Activo.activo: desactivar en vez de
  // eliminar.
  activo               Boolean        @default(true)
  createdAt            DateTime       @default(now())
  // Para optimistic locking en actualizarCostoOperativo (Tanda 3 del audit
  // crítico) — Documento ya lo tenía, Costo no.
  updatedAt            DateTime       @updatedAt

  // Fase 3: opcionales — un costo registrado antes de esta fase, o uno que
  // el usuario decide no ligar a ningún cliente/proyecto en particular,
  // queda en null. Nunca inferir un valor por defecto acá.
  proyectoId String?
  proyecto   Proyecto? @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  clienteId  String?
  cliente    Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  auditoria CostoOperativoAuditoria[]

  @@index([empresaId, fechaGasto])
  @@index([proyectoId])
  @@index([clienteId])
  @@map("costos_operativos")
}

enum AccionCosto {
  CREADO
  EDITADO
  ELIMINADO
}

// Bitácora de solo-inserción — a diferencia de HistorialEstado (que existe
// para el flujo de negocio de un documento), esta tabla existe únicamente
// para trazabilidad ("¿quién cambió/borró este gasto?"): CostoOperativo
// sigue siendo borrado físico (decisión ya tomada — un costo mal cargado no
// necesita quedar en la tabla en sí), pero ahora queda un rastro de quién
// hizo qué y cuándo, incluso después de borrado. Por eso costoOperativoId es
// opcional con onDelete: SetNull en vez de Cascade: si se borra el costo,
// esta fila sobrevive (huérfana de esa relación) en vez de desaparecer con
// él — y por eso categoria/descripcion/monto/fechaGasto se copian acá tal
// cual quedaron en ese momento, no se leen por relación.
model CostoOperativoAuditoria {
  id                   String          @id @default(cuid())
  costoOperativoId     String?
  costoOperativo       CostoOperativo? @relation(fields: [costoOperativoId], references: [id], onDelete: SetNull)
  empresaId            String
  empresa              Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  accion               AccionCosto
  categoria            CategoriaCosto
  categoriaOtroDetalle String?
  descripcion          String
  monto                Decimal         @db.Decimal(12, 2)
  fechaGasto           DateTime
  usuarioId            String?
  usuario              Usuario?        @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  fecha                DateTime        @default(now())

  @@index([empresaId, fecha])
  @@map("costos_operativos_auditoria")
}

model Servicio {
  id         String  @id @default(cuid())
  empresaId  String
  empresa    Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre     String
  precioFijo Decimal @db.Decimal(12, 2)
  activo     Boolean @default(true)

  auditoria ServicioAuditoria[]

  @@index([empresaId])
  @@map("servicios")
}

enum AccionServicio {
  CREADO
  EDITADO
}

model ServicioAuditoria {
  id             String         @id @default(cuid())
  servicioId     String?
  servicio       Servicio?      @relation(fields: [servicioId], references: [id], onDelete: SetNull)
  empresaId      String
  empresa        Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  accion         AccionServicio
  servicioNombre String
  detalle        String
  usuarioId      String?
  usuario        Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  fecha          DateTime       @default(now())

  @@index([empresaId, fecha])
  @@map("servicios_auditoria")
}

enum AccionProyecto {
  CREADO
  EDITADO
}

// Proyecto y Activo eran los únicos modelos con mutaciones sin bitácora —
// Tanda 3 del audit crítico. Mismo shape que ServicioAuditoria.
// empresaId se guarda denormalizado (Proyecto en sí solo tiene clienteId,
// no empresaId directo) para poder filtrar/aislar por empresa sin tener
// que atravesar la relación con Cliente en cada query.
model ProyectoAuditoria {
  id             String         @id @default(cuid())
  proyectoId     String?
  proyecto       Proyecto?      @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  clienteId      String?
  cliente        Cliente?       @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  empresaId      String
  empresa        Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  accion         AccionProyecto
  proyectoNombre String
  detalle        String
  usuarioId      String?
  usuario        Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  fecha          DateTime       @default(now())

  @@index([empresaId, fecha])
  @@map("proyectos_auditoria")
}

enum AccionActivo {
  CREADO
  EDITADO
}

model ActivoAuditoria {
  id             String       @id @default(cuid())
  activoId       String?
  activoRegistro Activo?      @relation(fields: [activoId], references: [id], onDelete: SetNull)
  empresaId      String
  empresa        Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  accion         AccionActivo
  activoNombre   String
  detalle        String
  usuarioId      String?
  usuario        Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  fecha          DateTime     @default(now())

  @@index([empresaId, fecha])
  @@map("activos_auditoria")
}

// Empresa no tiene alta/baja desde la UI (las 4 vienen precargadas) — solo
// EDITADO existe hoy, sin enum de acción todavía porque no hay otra opción
// real; se agrega si algún día se permite crear/eliminar una empresa.
model EmpresaAuditoria {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  detalle   String
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  fecha     DateTime @default(now())

  @@index([empresaId, fecha])
  @@map("empresas_auditoria")
}

enum AccionUsuario {
  ACCESO_ACTUALIZADO
  FIRMA_ACTUALIZADA
  FIRMA_ELIMINADA
  ELIMINADO
}

// usuarioId (a quién le pasó esto) y actorUsuarioId (quién lo hizo) son
// relaciones DISTINTAS hacia Usuario — ver comentario en el modelo Usuario.
// usuarioNombre/usuarioEmail se copian porque si accion = ELIMINADO, la fila
// de Usuario ya no existe (usuarioId queda null vía SetNull).
model UsuarioAuditoria {
  id             String        @id @default(cuid())
  usuarioId      String?
  usuario        Usuario?      @relation("UsuarioAuditado", fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioNombre  String
  usuarioEmail   String
  accion         AccionUsuario
  detalle        String
  actorUsuarioId String?
  actor          Usuario?      @relation("UsuarioAuditor", fields: [actorUsuarioId], references: [id], onDelete: SetNull)
  fecha          DateTime      @default(now())

  @@index([fecha])
  @@map("usuarios_auditoria")
}

model Documento {
  id                 String          @id @default(cuid())
  empresaId          String
  empresa            Empresa         @relation(fields: [empresaId], references: [id])
  tipo               TipoDocumento
  // Un solo correlativo por empresa, compartido entre los 3 tipos de documento —
  // decisión final confirmada en docs/data-model.md, no agregar `tipo` a la unique.
  correlativo        Int
  clienteId          String?
  cliente            Cliente?        @relation(fields: [clienteId], references: [id])
  // Fase 3: opcional — documentos previos a esta fase quedan en null, nunca
  // se les infiere un proyecto. Validar en el server action que, si se
  // envía, el proyecto pertenezca al mismo clienteId de este documento.
  proyectoId         String?
  proyecto           Proyecto?       @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  fecha              DateTime
  vigenciaDias       Int?            @default(15)
  condicionesPago    String?
  descripcionGeneral String?         @db.Text // campo "Descripción general" pedido por el cliente
  subtotal           Decimal         @db.Decimal(12, 2)
  descuento          Decimal         @default(0) @db.Decimal(12, 2)
  total              Decimal         @db.Decimal(12, 2)
  notas              Json // [{ titulo: string, texto: string }]
  anexos             Json? // string[] — solo aplica a propuestas
  estado             EstadoDocumento @default(BORRADOR)
  duplicadoDeId      String? // referencia al documento original si se creó con "Duplicar"
  // Firma: opcional en los 3 campos — un documento sin firmante se imprime
  // exactamente igual que antes de este campo (espacio en blanco para firmar
  // a mano). onDelete: SetNull porque si se borra el Usuario firmante, el
  // documento no debe romperse, solo vuelve a quedar sin firma automática.
  firmanteUsuarioId  String?
  firmante           Usuario?        @relation("DocumentoFirmante", fields: [firmanteUsuarioId], references: [id], onDelete: SetNull)
  nombreResponsable  String?
  fechaAceptacion    DateTime?
  // Alternativa al "soft delete" original que se descartó (liberar/reusar
  // el correlativo choca con "nunca se pierde el historial", ver
  // CLAUDE.md) — anulado es ortogonal a `estado`: aplica en cualquier
  // estado (incluida FACTURADA, para cancelaciones reales de una factura ya
  // cobrada), nunca borra la fila ni libera el correlativo, y solo saca al
  // documento de los totales de dinero (panel/reportes/exportaciones). El
  // documento sigue visible en el listado con un badge, siempre.
  anulado            Boolean         @default(false)
  motivoAnulacion    String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  items     ItemDocumento[]
  historial HistorialEstado[]

  @@unique([empresaId, correlativo])
  @@index([empresaId, tipo, estado])
  @@index([proyectoId])
  @@map("documentos")
}

model ItemDocumento {
  id             String    @id @default(cuid())
  documentoId    String
  documento      Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  orden          Int // para mantener el orden de renglones al editar
  cantidad       Decimal   @db.Decimal(10, 2)
  descripcion    String    @db.Text // sin límite de longitud — ver docs/document-export.md
  precioUnitario Decimal   @db.Decimal(12, 2)

  @@map("items_documento")
}

// Historial append-only: nunca se actualiza ni se borra una fila existente.
model HistorialEstado {
  id          String          @id @default(cuid())
  documentoId String
  documento   Documento       @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  fecha       DateTime        @default(now())
  estado      EstadoDocumento
  nota        String?

  @@map("historial_estado")
}

enum TipoActivo {
  CABEZAL
  FURGON_SECO
  FURGON_REFRIGERADO
  PLATAFORMA
  LOWBOY
  CISTERNA
  CAMION
  CAMION_C3
  CAMION_C2
  PORTACONTENEDOR
  // Pedido de Oldemar (feedback sobre el módulo ya entregado): igual que
  // CostoOperativo.categoria = OTRO — un tipo que no encaja en la lista fija
  // se registra acá con un detalle libre en tipoOtroDetalle, y se puede
  // filtrar después como si fuera un tipo más.
  OTRO
}

// Fase 3 — registro de camiones, maquinaria y equipo por empresa. `costo` es
// lo que costó adquirirlo/traerlo (incluyendo traslado si vino del
// extranjero); `valor` es su valor actual como activo ya operando en
// Guatemala. `modelo` reemplaza el concepto de "año" — pedido explícito del
// cliente.
model Activo {
  id              String     @id @default(cuid())
  empresaId       String
  empresa         Empresa    @relation(fields: [empresaId], references: [id])
  tipo            TipoActivo
  // Solo aplica (y se exige, ver refine en lib/validations/activo.ts) cuando
  // tipo = OTRO — nunca se guarda si tipo es cualquier otro valor.
  tipoOtroDetalle String?
  placa           String?
  modelo          String?
  // Pedido de Oldemar (feedback sobre el módulo ya entregado, no parte del
  // alcance original de Fase 3.5): marca del vehículo/equipo, y una
  // descripción libre — sin límite de longitud, mismo criterio de "nunca
  // truncar texto libre" que ya rige el resto del sistema.
  marca           String?
  descripcion     String?    @db.Text
  costo           Decimal    @db.Decimal(12, 2)
  valor           Decimal    @db.Decimal(12, 2)
  activo          Boolean    @default(true)
  createdAt       DateTime   @default(now())

  auditoria ActivoAuditoria[]

  @@index([empresaId])
  @@map("activos")
}
