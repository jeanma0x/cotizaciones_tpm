// schema.prisma
// Ver docs/data-model.md para el razonamiento detrás de cada decisión.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  SUPERUSUARIO
  MIEMBRO
}

enum TipoDocumento {
  COTIZACION
  PROPUESTA
  FACTURA
}

enum EstadoDocumento {
  BORRADOR
  ENVIADA
  EN_NEGOCIACION
  ACEPTADA
  RECHAZADA
  VENCIDA
  FACTURADA
}

// INDIVIDUAL: el flujo de siempre (un solo contacto/correo/teléfono en el
// propio Cliente). EMPRESA: clientes corporativos como CMI, donde cada mes
// la cotización se manda a un destinatario distinto bajo el mismo NIT — ahí
// se usan los ContactoCliente en vez del correo suelto del cliente.
// Pedido explícito de Oldemar, reunión 14/08.
enum TipoCliente {
  INDIVIDUAL
  EMPRESA
}

model Empresa {
  id                String   @id @default(cuid())
  nombre            String
  nit               String?
  direccion         String?
  // Persona de contacto de ESTA empresa (la que emite el documento) — se muestra
  // como "Contacto de servicio" en el documento exportado, junto con telefono/email
  // de esta misma empresa. No confundir con Cliente.contacto (el contacto del
  // cliente). Ver docs/document-export.md.
  contacto          String?
  telefono          String?
  email             String?
  // Código de país para armar el link de WhatsApp del botón "Ver / Imprimir"
  // (ej. "502" Guatemala, "507" Panamá, "1" Estados Unidos) — wa.me exige el
  // número completo con código de país, y Cliente.telefono nunca lo incluye.
  // Sirve de default para todos los clientes de esta empresa; un cliente
  // puntual puede sobreescribirlo con su propio Cliente.codigoPais si su
  // WhatsApp real es de un país distinto al de la empresa que lo atiende.
  codigoPais        String   @default("502")
  moneda            String   @default("GTQ")
  correlativoActual Int      @default(1000) // el próximo asignado será +1 (ver lib/correlativo.ts)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  usuarios        UsuarioEmpresa[]
  clientes        Cliente[]
  servicios       Servicio[]
  documentos      Documento[]
  costosOperativos CostoOperativo[]

  @@map("empresas")
}

model Usuario {
  id        String     @id @default(cuid())
  clerkId   String     @unique // referencia al usuario en Clerk, fuente de verdad de auth
  nombre    String
  email     String     @unique
  rol       RolUsuario @default(MIEMBRO)
  createdAt DateTime   @default(now())

  empresas UsuarioEmpresa[]

  @@map("usuarios")
}

// Tabla puente: qué usuario puede acceder a qué empresa.
// El superusuario igual tiene filas aquí para cada empresa (no se asume acceso total
// implícito en el código — se hace explícito en la base de datos también).
model UsuarioEmpresa {
  id        String  @id @default(cuid())
  usuarioId String
  empresaId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, empresaId])
  @@map("usuario_empresa")
}

model Cliente {
  id        String      @id @default(cuid())
  empresaId String
  empresa   Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo      TipoCliente @default(INDIVIDUAL)
  nombre    String
  nit       String?
  direccion String?
  contacto  String?
  telefono  String?
  email     String?
  // Solo se llena cuando el WhatsApp real de ESTE cliente es de un país
  // distinto al de la empresa que lo atiende — si es null, se usa
  // Empresa.codigoPais. Ver ese campo para el porqué.
  codigoPais String?
  activo    Boolean     @default(true) // permite ocultar clientes viejos sin borrarlos
  createdAt DateTime    @default(now())

  documentos Documento[]
  // Solo se usan cuando tipo = EMPRESA — ver TipoCliente. Un cliente
  // INDIVIDUAL sigue usando el campo `email` de acá arriba, sin tocar nada.
  contactos  ContactoCliente[]

  @@index([empresaId])
  @@map("clientes")
}

// Destinatarios distintos bajo el mismo NIT corporativo (ej. CMI: 4 personas
// distintas reciben la cotización cada mes, según el servicio). Se elige uno
// al generar/enviar el documento — ver documento-imprimir-toolbar.tsx.
model ContactoCliente {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nombre    String
  email     String
  createdAt DateTime @default(now())

  @@index([clienteId])
  @@map("contactos_cliente")
}

// Categorías fijas pedidas por Oldemar en la reunión del 14/08 (combustible,
// planilla, etc.) — "Otro" cubre lo que no encaje, sin forzar categorías
// nuevas antes de tener más ejemplos reales de gasto.
enum CategoriaCosto {
  COMBUSTIBLE
  PLANILLA
  PROVEEDORES
  PREDIO
  LUZ
  CONSUMIBLES
  OTRO
}

// Gasto operativo real (no una venta) — por eso no puede vivir en Documento,
// que está diseñado para cotizaciones/propuestas/facturas con su propio
// flujo de estados y correlativo. Sirve para calcular "Utilidad neta" en el
// panel: Facturado del mes − Costos del mes. El cálculo automático de
// ISR/IVA queda pendiente de la fórmula exacta que Oldemar va a mandar — no
// se inventa acá.
model CostoOperativo {
  id          String         @id @default(cuid())
  empresaId   String
  empresa     Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  categoria   CategoriaCosto
  descripcion String
  monto       Decimal        @db.Decimal(12, 2)
  // Independiente de createdAt: un reporte de julio puede llegar y
  // registrarse recién el 5 de agosto, pero debe contar para julio.
  fechaGasto  DateTime
  createdAt   DateTime       @default(now())

  @@index([empresaId, fechaGasto])
  @@map("costos_operativos")
}

model Servicio {
  id         String  @id @default(cuid())
  empresaId  String
  empresa    Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre     String
  precioFijo Decimal @db.Decimal(12, 2)
  activo     Boolean @default(true)

  @@index([empresaId])
  @@map("servicios")
}

model Documento {
  id                 String          @id @default(cuid())
  empresaId          String
  empresa            Empresa         @relation(fields: [empresaId], references: [id])
  tipo               TipoDocumento
  // Un solo correlativo por empresa, compartido entre los 3 tipos de documento —
  // decisión final confirmada en docs/data-model.md, no agregar `tipo` a la unique.
  correlativo        Int
  clienteId          String?
  cliente            Cliente?        @relation(fields: [clienteId], references: [id])
  fecha              DateTime
  vigenciaDias       Int?            @default(15)
  condicionesPago    String?
  descripcionGeneral String?         @db.Text // campo "Descripción general" pedido por el cliente
  subtotal           Decimal         @db.Decimal(12, 2)
  descuento          Decimal         @default(0) @db.Decimal(12, 2)
  total              Decimal         @db.Decimal(12, 2)
  notas              Json // [{ titulo: string, texto: string }]
  anexos             Json? // string[] — solo aplica a propuestas
  estado             EstadoDocumento @default(BORRADOR)
  duplicadoDeId      String? // referencia al documento original si se creó con "Duplicar"
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  items     ItemDocumento[]
  historial HistorialEstado[]

  @@unique([empresaId, correlativo])
  @@index([empresaId, tipo, estado])
  @@map("documentos")
}

model ItemDocumento {
  id             String    @id @default(cuid())
  documentoId    String
  documento      Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  orden          Int // para mantener el orden de renglones al editar
  cantidad       Decimal   @db.Decimal(10, 2)
  descripcion    String    @db.Text // sin límite de longitud — ver docs/document-export.md
  precioUnitario Decimal   @db.Decimal(12, 2)

  @@map("items_documento")
}

// Historial append-only: nunca se actualiza ni se borra una fila existente.
model HistorialEstado {
  id          String          @id @default(cuid())
  documentoId String
  documento   Documento       @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  fecha       DateTime        @default(now())
  estado      EstadoDocumento
  nota        String?

  @@map("historial_estado")
}
